<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Используется при наличии Developer ID сертификата (платный Apple Developer).
    Если сертификата нет — скрипт build_dmg.sh автоматически переключится
    на ad-hoc подпись и создаст DMG для локального использования.
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>developer-id</string>

    <!-- Замените на ваш Team ID из developer.apple.com/account -->
    <key>teamID</key>
    <string>XXXXXXXXXX</string>

    <key>signingStyle</key>
    <string>automatic</string>

    <key>hardcodedBuildNumber</key>
    <false/>

    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
